# .env.example — copy to .env and fill in real values.
# This file is committed; .env is gitignored.

# -- MCP server credentials ---------------------------------------------------
# Used by .bob/mcp.json env blocks so Bob can start both MCP servers.

# Financial Modeling Prep API key.
# The financial-modeling-prep-mcp-server npx package reads this as FMP_API_KEY.
FMP_API_KEY=your_fmp_api_key_here

# Bigdata API key.
# The @bigdata/mcp-server npx package reads this as BIGDATA_API_KEY.
BIGDATA_API_KEY=your_bigdata_api_key_here

# -- Pipeline helpers ---------------------------------------------------------
# Project root -- set automatically by scripts/run_daily.ps1; override if
# running Python/Node pipeline scripts from a non-standard working directory.
# TDD_BASE=/path/to/tech_drawdown